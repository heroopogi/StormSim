# Normalize text files while preserving Windows checkout conventions.
* text=auto
*.cs text diff=csharp
*.shader text
*.compute text
*.json text
*.xml text
*.asmdef text
*.asmref text
*.meta text
*.md text
*.txt text

# Unity scenes and serialized assets exceed common Git hosting file limits in
# this project, so keep them in Git LFS with the other binary project assets.
*.unity filter=lfs diff=lfs merge=lfs -text
*.asset filter=lfs diff=lfs merge=lfs -text
